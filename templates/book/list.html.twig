{% if list is empty %}

No Books found 
{% else %}
<ul>
{% for b in list %}
<li>{{b.id}} - {{b.publicationDate | date('d/m/y')}} - {{b.author.username}}
<a href="{{path('app_book_updateForm',{'id': b.id })}}">Modifier</a>
<a href="{{path('app_book_delete1',{'id': b.id })}}">Supprimer1</a>
<a href="{{path('app_book_delete2',{'id': b.id })}}">Supprimer2</a>
<a href="{{path('app_book_details',{'id': b.id })}}">Show</a>
</li>

{% endfor %}
</ul>
<p>Nombre de livres publié: {{nbpub}} </p>
<p>Nombre de livres non publié: {{nbNotPub}} </p>
<a href="{{path('app_book_enabled')}}">Enabled book</a>
{% endif %}

<button><a href="{{path('app_book_newForm')}}">Create new </a></button>